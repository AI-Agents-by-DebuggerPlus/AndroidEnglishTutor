<Window x:Class="Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AET Desktop"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="CanResize"
        Background="Black"
        MouseMove="Window_MouseMove"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <StackPanel x:Name="IdlePanel" VerticalAlignment="Center" Margin="32">
            <TextBlock x:Name="IdleTitle"
                       Text="AET Desktop"
                       Foreground="#E8F4F3"
                       FontSize="28"
                       TextAlignment="Center"/>
            <TextBlock x:Name="IdleStatus"
                       Margin="0,16,0,0"
                       Foreground="#8AA8A6"
                       FontSize="16"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Text="Подключение к Supabase…"/>
            <TextBlock x:Name="IdleHint"
                       Margin="0,28,0,0"
                       Foreground="#8AA8A6"
                       FontSize="14"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Text="Только экран урока. Озвучка и кнопки гарнитуры остаются на телефоне. Мышь или клавиша снова показывает карточку. Курсор скрывается через пять секунд бездействия. F или Escape переключает полный экран. Ctrl и + или − меняют масштаб."/>
        </StackPanel>

        <StackPanel x:Name="CardPanel" VerticalAlignment="Center" Margin="28,48,28,72" Visibility="Collapsed">
            <TextBlock x:Name="EnglishText"
                       Foreground="#E8F4F3"
                       FontSize="48"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="RussianText"
                       Margin="0,20,0,0"
                       Foreground="#8AA8A6"
                       FontSize="28"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid x:Name="BottomBar" VerticalAlignment="Bottom" Margin="12,0,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="CountdownPanel"
                        Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <ProgressBar x:Name="CountdownBar"
                             Width="96"
                             Height="4"
                             Minimum="0"
                             Maximum="1"
                             VerticalAlignment="Center"
                             Foreground="#8AA8A6"
                             Background="#408AA8A6"/>
                <TextBlock x:Name="CountdownText"
                           Margin="8,0,0,0"
                           Foreground="#8AA8A6"
                           FontSize="13"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Grid x:Name="TopicStage" Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TopicText"
                           Foreground="#E8F4F3"
                           FontSize="16"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="StageText"
                           Grid.Column="1"
                           Margin="12,0,0,0"
                           Foreground="#8AA8A6"
                           FontSize="14"
                           VerticalAlignment="Center"/>
            </Grid>
            <StackPanel x:Name="Chrome"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="—" Width="42" Height="32" Margin="0,0,8,0" Click="Minimize_Click"/>
                <Button x:Name="FullScreenButton" Content="❐" Width="42" Height="32" Margin="0,0,8,0" Click="Fullscreen_Click"/>
                <Button Content="⚙" Width="42" Height="32" Margin="0,0,8,0" Click="Settings_Click"/>
                <Button Content="✕" Width="42" Height="32" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <Rectangle x:Name="BrightnessCover" Fill="Black" IsHitTestVisible="False" Opacity="0"/>
        <Rectangle x:Name="DimCover" Fill="Black" Visibility="Collapsed"/>
    </Grid>
</Window>
