<Window x:Class="Desktop.XShoot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XSHOOT — AET"
        Width="920"
        Height="680"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#FF2B2B2B"
        Foreground="#FFF5F5F5"
        FontFamily="Segoe UI"
        FontSize="15"
        KeyDown="OnWindowKeyDown">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="XSHOOT" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <RadioButton x:Name="TabSetup" Content="Упражнения" GroupName="Tabs" Margin="8,0"
                     IsChecked="True" Checked="OnTabChanged" Foreground="#FFF5F5F5" />
        <RadioButton x:Name="TabLearning" Content="Обучение" GroupName="Tabs" Margin="8,0"
                     Checked="OnTabChanged" Foreground="#FFF5F5F5" />
        <RadioButton x:Name="TabShoot" Content="Тир" GroupName="Tabs" Margin="8,0"
                     Checked="OnTabChanged" Foreground="#FFF5F5F5" />
      </StackPanel>
    </DockPanel>

    <!-- Setup / stats -->
    <Grid x:Name="PanelSetup" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.2*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Background="#FF3A3A3A" CornerRadius="8" Padding="16" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Text="Словарь" FontWeight="SemiBold" Margin="0,0,0,8" />
          <CheckBox x:Name="ChkConcise" Content="Только краткий набор" Margin="0,0,0,12"
                    Foreground="#FFF5F5F5" Checked="OnOptionsChanged" Unchecked="OnOptionsChanged" />
          <TextBlock Text="Режим" FontWeight="SemiBold" Margin="0,0,0,8" />
          <RadioButton x:Name="ModeLearning" Content="Обучение" GroupName="Mode" IsChecked="True"
                       Foreground="#FFF5F5F5" Checked="OnOptionsChanged" Margin="0,0,0,4" />
          <RadioButton x:Name="ModeOrdinary" Content="Обычный (тир)" GroupName="Mode"
                       Foreground="#FFF5F5F5" Checked="OnOptionsChanged" Margin="0,0,0,12" />
          <Button Content="Новая партия слов" Click="OnNewBatch" Padding="10,6" Margin="0,0,0,8"
                  HorizontalAlignment="Left" />
          <Button Content="Открыть тир" Click="OnOpenShoot" Padding="10,6" Margin="0,0,0,8"
                  HorizontalAlignment="Left" />
          <Button Content="Открыть папку архива" Click="OnOpenArchiveFolder" Padding="10,6"
                  HorizontalAlignment="Left" />
          <TextBlock x:Name="TxtArchivePath" Margin="0,16,0,0" TextWrapping="Wrap"
                     Foreground="#FFB0B0B0" FontSize="12" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="#FF3A3A3A" CornerRadius="8" Padding="16">
        <StackPanel>
          <TextBlock Text="Архив и статистика" FontWeight="SemiBold" Margin="0,0,0,12" />
          <TextBlock x:Name="TxtStats" TextWrapping="Wrap" LineHeight="24" />
          <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#FFB0B0B0" FontSize="13"
                     Text="Отгаданные слова попадают в архив. При сборке уроков AET и на телефоне эти слова не берутся как отдельные карточки, но могут встречаться в словосочетаниях и предложениях." />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Learning mode -->
    <Grid x:Name="PanelLearning" Grid.Row="1" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.9*" />
        <ColumnDefinition Width="1.2*" />
      </Grid.ColumnDefinitions>
      <Border Background="#FF3A3A3A" CornerRadius="8" Margin="0,0,8,0" Padding="8">
        <ListBox x:Name="ListWords" Background="Transparent" BorderThickness="0"
                 Foreground="#FF7EB6FF" FontSize="18" FontWeight="SemiBold"
                 SelectionChanged="OnWordSelected">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="8,6" />
              <Setter Property="Margin" Value="0,1" />
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </Border>
      <Border Grid.Column="1" Background="#FF454545" CornerRadius="8" Padding="20">
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="TxtLearnEn" FontSize="28" FontWeight="Bold" Foreground="#FFFF6B6B" />
          <TextBlock x:Name="TxtLearnRu" FontSize="22" Margin="0,12,0,0" TextWrapping="Wrap" />
          <TextBlock x:Name="TxtLearnHint" Margin="0,24,0,0" Foreground="#FFB0B0B0" FontSize="13"
                     Text="Выберите слово слева. Enter или «В тир» — проверка перевода." />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Shooting gallery -->
    <Grid x:Name="PanelShoot" Grid.Row="1" Visibility="Collapsed">
      <Border Background="#FF1E3A4C" CornerRadius="8" Padding="20">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Background="#FF0D1B24" CornerRadius="6" Padding="24" VerticalAlignment="Center"
                  HorizontalAlignment="Stretch" MaxWidth="720">
            <StackPanel>
              <TextBlock Text="Переведите на английский" Foreground="#FF8FA8B8" FontSize="13"
                         HorizontalAlignment="Center" />
              <TextBlock x:Name="TxtBoard" FontSize="30" FontWeight="SemiBold" Foreground="#FF7CFF9A"
                         TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
              <ProgressBar x:Name="BarTimer" Height="8" Margin="0,18,0,0" Minimum="0" Maximum="1"
                           Value="1" Foreground="#FFE8C547" Background="#FF2A4454" BorderThickness="0" />
              <TextBlock x:Name="TxtShootFeedback" Margin="0,12,0,0" TextAlignment="Center"
                         FontSize="16" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <TextBlock Text="English word:" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox x:Name="TxtAnswer" Width="360" FontSize="18" Padding="8,6"
                     KeyDown="OnAnswerKeyDown" />
            <Button Content="Ок" Margin="8,0,0,0" Padding="16,6" Click="OnSubmitAnswer" />
            <Button Content="Пропуск" Margin="8,0,0,0" Padding="12,6" Click="OnSkip" />
            <Button x:Name="BtnPause" Content="Пауза" Margin="8,0,0,0" Padding="12,6" Click="OnPause" />
          </StackPanel>
          <TextBlock x:Name="TxtShootStatus" Grid.Row="2" Margin="0,12,0,0"
                     HorizontalAlignment="Center" Foreground="#FFB0B0B0" />
        </Grid>
      </Border>
    </Grid>

    <DockPanel Grid.Row="2" Margin="0,10,0,0">
      <TextBlock x:Name="TxtFooter" VerticalAlignment="Center" Foreground="#FFB0B0B0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="В тир" Click="OnOpenShoot" Padding="12,6" Margin="0,0,8,0" />
        <Button Content="Выход" Click="OnExit" Padding="12,6" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
